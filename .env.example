# Preencha UMA das chaves abaixo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (padrão: gpt-4o-mini / claude-sonnet-4-5)
MODEL=

# SEO: link público do site. Com ele definido, o site se cadastra sozinho nos buscadores.
SITE_URL=
# Google (opcional): conteúdo do JSON da conta de serviço OU caminho do arquivo
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Seu e-mail, para ver o site no Google Search Console
GOOGLE_OWNER_EMAIL=
# Opcional: códigos de verificação manual
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
# Opcional: chave IndexNow própria (se vazio, é gerada a partir do domínio)
INDEXNOW_KEY=
